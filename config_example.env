# Intel-Optimized-MoE - Configurazione di Esempio
# Copia questo file in .env e modifica secondo necessita'

# Percorso al file modello GGUF (obbligatorio)
# FLASH_MOE_GGUF=D:\models\Hermes3.6-35B-A3B-Uncensored-Genesis-Final-APEX-Compact.gguf

# Dimensione massima del contesto
FLASH_MOE_MAX_SEQ=2048

# Numero massimo di token generati per risposta
FLASH_MOE_MAX_TOKENS=512

# Temperatura per sampling (0 = deterministico)
FLASH_MOE_TEMP=0.7

# Dimensione cache esperti quantizzati
FLASH_MOE_CACHE=320

# Dimensione cache pesi convertiti
FLASH_MOE_WEIGHT_CACHE=1

# Dispositivo principale OpenVINO (CPU, GPU, NPU, AUTO)
FLASH_MOE_DEVICE=AUTO

# Dispositivo per DeltaNet (CPU, GPU)
FLASH_MOE_SSM_DEVICE=GPU

# Dispositivo per Attention (CPU, GPU)
FLASH_MOE_ATTENTION_DEVICE=GPU

# Modalita' decode nativo (auto, native, openvino)
FLASH_MOE_NATIVE_DECODE=auto

# Numero di worker per esperti
FLASH_MOE_EXPERT_WORKERS=4

# Thread per prefill
FLASH_MOE_PREFILL_THREADS=4

# Thread per inference OpenVINO
FLASH_MOE_INFERENCE_THREADS=1

# Thread BLAS (1 consigliato per performance ottimali)
FLASH_MOE_BLAS_THREADS=1

# Note:
# - Tutti questi valori possono essere sovrascritti da argomenti command-line
# - Le variabili ambiente hanno precedenza sui valori predefiniti
# - I valori commentati sono quelli di default
